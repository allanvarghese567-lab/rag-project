# Copy to .env for local runs (never commit .env with real secrets)
#   cp .env.example .env

# --- LLM (active: xai-grok → needs XAI_API_KEY) ---
XAI_API_KEY=xai-your-key-here
# Optional other providers:
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
# LLM_API_KEY=your-gateway-key
# EMBED_API_KEY=your-gateway-key

# Optional: force profile ids from config/*.json
# LLM_PROFILE=xai-grok
# EMBED_PROFILE=openai-small

# --- GitHub (POST /jobs/reindex) ---
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=allanvarghese567-lab
GITHUB_REPO=rag-project
GITHUB_BRANCH=main
