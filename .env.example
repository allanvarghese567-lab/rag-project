# Copy to .env for local runs (never commit .env with real secrets)
#   cp .env.example .env

# --- LLM / embeddings ---
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
# Optional: override active profiles from config/*.json
# EMBED_PROFILE=openai-small
# LLM_PROFILE=openai-gpt4o-mini
# For openai_compatible LLM / embedding gateways:
# LLM_API_KEY=your-gateway-key
# EMBED_API_KEY=your-gateway-key

# --- GitHub (POST /jobs/reindex + /console "Start reindex job") ---
# Create a fine-grained PAT: repo access to this repo only
# Permissions: Actions (Read and write), Contents (Read-only)
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=allanvarghese567-lab
GITHUB_REPO=rag-project
GITHUB_BRANCH=main
